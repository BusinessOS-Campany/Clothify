# --- Database (PostgreSQL 16, local) ---
# Provide a dedicated role or use the postgres superuser in development.
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/clothify?schema=public"

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# --- Storage (private uploads — never served statically) ---
STORAGE_DIR="./storage"

# --- Seed (development/demo only) ---
# CLOTHIFY_PLATFORM_ADMIN_EMAIL="admin@clothify.local"
# CLOTHIFY_PLATFORM_ADMIN_PASSWORD="ChangeMe!123"

# --- Subscription / billing ---
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""